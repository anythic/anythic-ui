{
  "name": "@anythic/ui",
  "version": "0.0.0",
  "description": "AI-native UI primitives and components for autonomous agents, streaming reasoning, and developer interfaces.",
  "license": "MIT",
  "author": "anythic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anythic/anythic-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/anythic/anythic-ui#readme",
  "bugs": {
    "url": "https://github.com/anythic/anythic-ui/issues"
  },
  "keywords": [
    "react",
    "ai",
    "llm",
    "agents",
    "chat",
    "streaming",
    "markdown",
    "tailwindcss",
    "components",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme.css": {
      "style": "./dist/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/theme.css dist/theme.css",
    "dev": "tsup --watch --onSuccess \"cp src/theme.css dist/theme.css\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@anythic/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
